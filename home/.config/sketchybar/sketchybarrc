#!/usr/bin/env bash
# SketchyBar: a thin bar at the bottom of the screen. The Dock autohides there
# and the macOS menu bar stays as it is. Shows the Space name (space-name),
# the front app, free RAM and the time.
PLUGINS="$HOME/.config/sketchybar/plugins"

sketchybar --bar position=bottom height=26 color=0xd01e1e2e blur_radius=20 \
  topmost=window padding_left=8 padding_right=8 display=all

sketchybar --default icon.font="JetBrains Mono:Bold:12.0" label.font="JetBrains Mono:Bold:12.0" \
  icon.color=0xffcdd6f4 label.color=0xffcdd6f4 padding_left=6 padding_right=6 icon.padding_right=4

sketchybar --add event space_label_change

sketchybar --add item space_name left \
  --set space_name icon=▣ label.color=0xff89b4fa script="$PLUGINS/space_name.sh" \
  --subscribe space_name space_change space_label_change display_change system_woke

sketchybar --add item front_app left \
  --set front_app icon.drawing=off label.color=0xffa6adc8 script='sketchybar --set "$NAME" label="$INFO"' \
  --subscribe front_app front_app_switched

sketchybar --add item clock right \
  --set clock update_freq=30 icon.drawing=off script='sketchybar --set "$NAME" label="$(date "+%a %d/%m %H:%M")"'

sketchybar --add item ram right \
  --set ram update_freq=15 icon=RAM script="$PLUGINS/ram.sh" \
  --subscribe ram system_woke

sketchybar --update
