#!/usr/bin/env sh
# yabai is here only to name Spaces (see ~/.local/bin/space-name).
# Windows stay floating, so Magnet and normal window behavior are unchanged.
yabai -m config layout float

# New Spaces and re-attached displays get their stored names back.
yabai -m signal --add event=space_created action="space-name --apply" label=space_name_created
yabai -m signal --add event=display_added action="space-name --apply" label=space_name_display
yabai -m signal --add event=space_changed action="sketchybar --trigger space_label_change" label=space_name_bar

space-name --apply || true
