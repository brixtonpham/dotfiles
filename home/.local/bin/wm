#!/usr/bin/env bash
# wm: window and Space actions for skhd hotkeys (~/.config/skhd/skhdrc).
# skhd runs as a launchd service without mise activation, so set PATH here.
#
#   wm grid ROWS:COLS:X:Y:W:H   place the focused window on a grid (yabai)
#   wm name                     ask for a name for the focused Space (space-name)
#   wm app NAME                 open or focus an app
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

die() { osascript -e "display notification \"$*\" with title \"wm\"" >/dev/null 2>&1 || true; echo "wm: $*" >&2; exit 1; }

case "${1:-}" in
  grid)
    [[ "${2:-}" =~ ^[0-9]+:[0-9]+:[0-9]+:[0-9]+:[0-9]+:[0-9]+$ ]] || die "grid needs ROWS:COLS:X:Y:W:H"
    yabai -m window --grid "$2" || die "yabai could not move the window (is yabai running?)"
    ;;
  name)
    current="$(yabai -m query --spaces --space | jq -r .label)" || die "yabai is not running"
    name="$(osascript -e "text returned of (display dialog \"Name this desktop (empty removes the name)\" default answer \"$current\" with title \"space-name\")")" || exit 0
    if [[ -z "$name" ]]; then space-name -d; else space-name "$name" || die "space-name refused that name"; fi
    ;;
  app)
    [[ -n "${2:-}" ]] || die "app needs a name"
    open -a "$2" || die "no app named $2"
    ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
